{
  "name": "codex-legends",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test tools/asset-worker.test.mjs tools/menu-profile-state.test.mjs && vitest run",
    "test:watch": "vitest",
    "test:asset-cache": "node --test tools/asset-worker.test.mjs",
    "check:unused": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "audit:assets": "node tools/audit-assets.mjs",
    "desktop:build": "node desktop/tools/build.mjs",
    "desktop:check": "tsc -p desktop/tsconfig.json && node --test desktop/infrastructure.test.cjs",
    "desktop:pack": "node desktop/tools/package.mjs --dir",
    "desktop:dist": "node desktop/tools/package.mjs",
    "desktop:tools": "npm --prefix desktop/toolchain install --no-audit --no-fund && node desktop/toolchain/node_modules/electron/install.js",
    "desktop:runtime": "node desktop/toolchain/node_modules/electron/install.js"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/three": "0.183.1",
    "fake-indexeddb": "^6.2.5",
    "sharp": "^0.35.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.18.4",
    "gsap": "^3.15.0",
    "pixi.js": "^8.20.1",
    "three": "0.186.0"
  }
}
